---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const assetPath = (path: string) =>
  path.startsWith("http") ? path : `${base}${path.replace(/^\/+/, "")}`;

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;

const { Content,  remarkPluginFrontmatter} = await render(entry);
const cover = assetPath(entry.data.image ?? "banner.png");
const readingTime = Math.max(1, Math.ceil(Number(remarkPluginFrontmatter.minutesRead ?? 1)));
---

  <Layout
  seo={{
    title: entry.data.title,
    description: entry.data.description,
    image: cover,
  }}
  >
  <article class="article-shell">
    <a class="article-back" href={`${base}blog/`}>← 所有文章</a>
    <p class="eyebrow">ARTICLE</p>
    <h1>{entry.data.title}</h1>
    <p class="article-description">{entry.data.description}</p>
    <div class="article-meta">
      <span>{entry.data.author}</span>
      <span>·</span>
      <time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toLocaleDateString("zh-CN")}</time>
      <span>·</span>
      <span>{readingTime} min read</span>
    </div>
    {entry.data.tags.length > 0 && (
      <div class="article-tags">
        {entry.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    )}
    <img class="article-cover" src={cover} alt={entry.data.title} />
    <div class="article-body"><Content /></div>
    <a class="article-back article-bottom-back" href={`${base}blog/`}>← 返回文章列表</a>
  </article>
  </section>
</Layout>

<style>
  .article-shell { width: min(100% - 3rem, 48rem); margin: 0 auto; padding: 3.5rem 0 5rem; }
  .article-back { display: inline-block; margin-bottom: 2.5rem; color: #0b7b83; font-size: .84rem; }
  .article-shell .eyebrow { margin: 0 0 .65rem; }
  .article-shell h1 { margin: 0; color: #17202b; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.08; letter-spacing: -.06em; }
  .article-description { margin: 1rem 0 0; color: #667585; font-size: 1.05rem; line-height: 1.7; }
  .article-meta { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.25rem; color: #8b98a6; font: .72rem ui-monospace, SFMono-Regular, Menlo, monospace; }
  .article-tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .8rem; }
  .article-tags span { padding: .25rem .45rem; border: 1px solid #cbdde1; border-radius: .3rem; color: #0b7b83; background: #f4fbfb; font-size: .68rem; }
  .article-cover { display: block; width: 100%; max-height: 25rem; margin: 2rem 0 2.5rem; border-radius: .65rem; object-fit: cover; background: #eef2f4; }
  .article-body { color: #3c4a58; font-size: 1rem; line-height: 1.85; }
  .article-body :global(h1) { margin: 2.6rem 0 .85rem; color: #17202b; font-size: 1.85rem; line-height: 1.2; letter-spacing: -.035em; }
  .article-body :global(h2) { margin: 2.2rem 0 .75rem; color: #17202b; font-size: 1.55rem; }
  .article-body :global(h3) { margin: 1.8rem 0 .6rem; color: #17202b; font-size: 1.2rem; }
  .article-body :global(p) { margin: 1rem 0; }
  .article-body :global(ul), .article-body :global(ol) { margin: 1rem 0; padding-left: 1.6rem; }
  .article-body :global(ul) { list-style: disc; }
  .article-body :global(ol) { list-style: decimal; }
  .article-body :global(li) { margin: .35rem 0; padding-left: .2rem; }
  .article-body :global(table) { display: block; width: 100%; margin: 1.4rem 0; overflow-x: auto; border-collapse: collapse; }
  .article-body :global(th), .article-body :global(td) { padding: .55rem .7rem; border: 1px solid #d9e1e8; text-align: left; white-space: nowrap; }
  .article-body :global(th) { color: #17202b; background: #eef7f8; font-weight: 650; }
  .article-body :global(hr) { margin: 2rem 0; border: 0; border-top: 1px solid #d9e1e8; }
  .article-body :global(a) { color: #0b7b83; text-decoration: underline; text-underline-offset: .2em; }
  .article-body :global(:not(pre) > code) { padding: .12rem .3rem; border-radius: .25rem; background: #eef2f4; color: #0b7b83; font-size: .9em; }
  .article-body :global(pre) { display: block; overflow-x: auto; margin: 1.4rem 0; padding: 1rem 1.1rem; border: 1px solid #263747; border-radius: .5rem; background: #17202b; color: #edf3f6; font: .88rem/1.65 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: pre; tab-size: 2; }
  .article-body :global(pre code) { display: block; padding: 0; background: transparent; color: inherit; font: inherit; white-space: inherit; }
  .article-body :global(blockquote) { margin: 1.4rem 0; padding: .2rem 1rem; border-left: 3px solid #0b9ba0; color: #667585; }
  .article-body :global(img) { max-width: 100%; border-radius: .5rem; }
  .article-bottom-back { margin-top: 3rem; }
  @media (max-width: 560px) { .article-shell { width: min(100% - 2rem, 42rem); padding-top: 2.5rem; } }
</style>
