---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { blogPageContent } from "../../config";
import { render } from "astro:content";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const assetPath = (path: string) =>
  path.startsWith("http") ? path : `${base}${path.replace(/^\/+/, "")}`;

const posts = await getCollection(
  "posts",
  ({ data }) => import.meta.env.DEV || !data.draft,
);
posts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});
const postsWithMeta = await Promise.all(
  posts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return {
      post,
      readingTime: Math.max(1, Math.ceil(Number(remarkPluginFrontmatter.minutesRead ?? 1))),
    };
  }),
);
---

<Layout seo={blogPageContent.seo}>
  <section class="blog-shell">
    <div class="blog-heading">
      <div>
        <p class="eyebrow">NOTES</p>
        <h1>文章</h1>
        <p>{blogPageContent.subtitle}</p>
      </div>
      <span class="post-count">{posts.length} 篇</span>
    </div>

    <div class="post-list">
      {
        postsWithMeta.map(({ post, readingTime }) => {
          const image = assetPath(post.data.image ?? "banner.png");
          return (
            <a href={`${base}blog/${post.id}/`} class="post-card">
              <img class="post-cover" src={image} alt={post.data.title} loading="lazy" />
              <div class="post-card-body">
                <p class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("zh-CN")}</time>
                  <span>·</span>
                  <span>{readingTime} min read</span>
                </p>
                <h2>{post.data.title}</h2>
                <p class="post-description">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <div class="post-tags">
                    {post.data.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                )}
              </div>
            </a>
          );
        })
      }
    </div>
    {posts.length === 0 && <p class="empty-note">文章正在整理中。</p>}
  </section>
</Layout>

<style>
  .blog-shell { width: min(100% - 3rem, 58rem); margin: 0 auto; padding: 4.5rem 0 5rem; }
  .blog-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid #d9e1e8; }
  .blog-heading .eyebrow { margin: 0 0 .55rem; }
  .blog-heading h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -.06em; }
  .blog-heading p:not(.eyebrow) { margin: .65rem 0 0; color: #667585; }
  .post-count { color: #8b98a6; font: .72rem ui-monospace, SFMono-Regular, Menlo, monospace; }
  .post-list { display: grid; gap: .8rem; margin-top: 1rem; }
  .post-card { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1.25rem; padding: 1rem; border: 1px solid #d9e1e8; border-radius: .65rem; background: #fff; transition: border-color .2s ease, transform .2s ease; }
  .post-card:hover { border-color: #0b9ba0; transform: translateY(-2px); }
  .post-cover { width: 9rem; height: 9rem; border-radius: .4rem; object-fit: cover; background: #eef2f4; }
  .post-card-body { min-width: 0; align-self: center; }
  .post-meta { display: flex; gap: .4rem; margin: 0 0 .6rem; color: #8b98a6; font: .7rem ui-monospace, SFMono-Regular, Menlo, monospace; }
  .post-card h2 { margin: 0; color: #17202b; font-size: 1.15rem; }
  .post-description { margin: .5rem 0 0; color: #667585; line-height: 1.6; }
  .post-tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .8rem; }
  .post-tags span { padding: .25rem .45rem; border: 1px solid #cbdde1; border-radius: .3rem; color: #0b7b83; background: #f4fbfb; font-size: .68rem; }
  @media (max-width: 560px) { .blog-shell { width: min(100% - 2rem, 42rem); padding-top: 2.5rem; } .post-card { grid-template-columns: 1fr; } .post-cover { width: 100%; height: 11rem; } }
</style>
