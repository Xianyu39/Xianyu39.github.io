---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import type { SEOInfo, StructuredData } from "../types/config";

interface Props {
  seo: SEOInfo;
  structuredData?: StructuredData[];
}

const { seo, structuredData = [] } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const siteUrl = Astro.site?.href ?? "https://xianyu39.github.io/";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(seo.image.replace(/^\/+/, ""), siteUrl).href;
const siteStructuredData = {
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  url: siteUrl,
  name: "Westwoods",
  description: "Westwoods 的 AI Infra、LLM Systems 与工程实践笔记。",
  inLanguage: "zh-CN",
};
const personStructuredData = {
  "@type": "Person",
  "@id": `${siteUrl}#person`,
  name: "Westwoods",
  url: siteUrl,
  sameAs: ["https://github.com/Xianyu39"],
  knowsAbout: ["AI Infra", "LLM Systems", "大模型推理", "GPU 性能优化", "LLMOps"],
};
const pageStructuredData = {
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: seo.title,
  description: seo.description,
  isPartOf: { "@id": `${siteUrl}#website` },
  inLanguage: "zh-CN",
};
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [siteStructuredData, personStructuredData, pageStructuredData, ...structuredData],
});
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}logo.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f7f9fb" />
    <meta property="og:type" content={seo.type ?? "website"} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Westwoods" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={imageUrl} />
    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <main class="mb-32">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Westwoods</span>
      <span><a href={`${base}blog/`}>文章</a> · Built with Astro</span>
    </footer>
  </body>
</html>

<style is:global>
  html {
    font-family: "Inter", "PingFang SC", "Microsoft YaHei", sans-serif;
    background: #f7f9fb;
  }

  * {
    -webkit-font-smoothing: antialiased;
    color: #17202b;
  }

  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }

  .hover-underline {
    text-decoration: underline 1px rgba(0, 0, 0, 0);
    text-underline-offset: 5px;
    transition: text-decoration-color 300ms;
  }

  .post:hover .hover-underline {
    text-decoration-color: rgba(23, 32, 43, 1);
  }
</style>
